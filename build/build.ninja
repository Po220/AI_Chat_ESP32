  COMMAND = cmd.exe /C "cd /D D:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat\build\esp-idf\wear_levelling && D:\soft_dawnload\esp\Espressif\tools\cmake\3.24.0\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
