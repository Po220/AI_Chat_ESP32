#############################################
# Utility command for edit_cache

build esp-idf/hal/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D D:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat\build\esp-idf\hal && D:\soft_dawnload\esp\Espressif\tools\cmake\3.24.0\bin\cmake-gui.exe -SD:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat -BD:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/hal/edit_cache: phony esp-idf/hal/CMakeFiles/edit_cache.util


