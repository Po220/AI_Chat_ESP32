#############################################
# Utility command for edit_cache

build esp-idf/soc/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D D:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat\build\esp-idf\soc && D:\soft_dawnload\esp\Espressif\tools\cmake\3.24.0\bin\cmake-gui.exe -SD:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat -BD:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/soc/edit_cache: phony esp-idf/soc/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/soc/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D D:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat\build\esp-idf\soc && D:\soft_dawnload\esp\Espressif\tools\cmake\3.24.0\bin\cmake.exe --regenerate-during-build -SD:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat -BD:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/soc/rebuild_cache: phony esp-idf/soc/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build esp-idf/soc/list_install_components: phony


#############################################
# Utility command for install

build esp-idf/soc/CMakeFiles/install.util: CUSTOM_COMMAND esp-idf/soc/all
  COMMAND = cmd.exe /C "cd /D D:\soft_dawnload\esp\Espressif\frameworks\esp-idf-v5.1.2\examples\ai_chat\build\esp-idf\soc && D:\soft_dawnload\esp\Espressif\tools\cmake\3.24.0\bin\cmake.exe -P cmake_install.cmake"
